# Copiar a .env y llenar. El archivo .env nunca se sube al repositorio.
# Generar valores con: openssl rand -hex 32
POSTGRES_USER=inbal
POSTGRES_PASSWORD=
POSTGRES_DB=inbal
DATABASE_URL=postgres://inbal:<POSTGRES_PASSWORD>@localhost:5432/inbal
PAYLOAD_SECRET=
# Almacenamiento en Supabase Storage (solo en la nube). Vacío: archivos en disco.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
